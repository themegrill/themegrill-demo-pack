png\" alt=\"\" class=\"wp-image-1768\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":1769,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https:\/\/elearning-fitness-trainer.instawp.site\/wp-content\/uploads\/2025\/09\/Youtube-1.png\" alt=\"\" class=\"wp-image-1769\"\/><\/figure>\n<!-- \/wp:image -->\n\n<!-- wp:image {\"id\":1770,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"https:\/\/elearning-fitness-trainer.instawp.site\/wp-content\/uploads\/2025\/09\/linkedin-1.png\" alt=\"\" class=\"wp-image-1770\"\/><\/figure>\n<!-- \/wp:image --><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:group -->"}}}